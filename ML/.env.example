# CodetyHub ML Microservice — Environment Variables
# Copy this file to .env and fill in your values.

# ── HuggingFace ────────────────────────────────────────────────────────────────
# Used by the CodeBERT evaluator to call the HuggingFace Inference API.
# Without this key the evaluator falls back to the local heuristic scorer.
HUGGINGFACE_API_KEY=
